# ─── Supabase ──────────────────────────────────────────────────────
# From your Supabase project dashboard: Settings > API
# The @nuxtjs/supabase module reads these directly from process.env
#
# ── Local Development (npx supabase start) ─────────────────────────
# Use the default local Supabase keys for development:
#   SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
#   SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
#
# ── Production ─────────────────────────────────────────────────────
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-anon-key
# SUPABASE_SERVICE_KEY=your-service-role-key

SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_KEY="your-local-anon-key"
SUPABASE_SERVICE_KEY="your-local-service-role-key"
SUPABASE_JWKS_URL="http://127.0.0.1:54321/auth/v1/.well-known/jwks.json"